{
  "id": "music.youtube.com",
  "name": "YouTube Music",
  "vocabularyVersion": 4,
  "search": [
    {
      "op": "extract.local",
      "mode": "search",
      "url": "https://music.youtube.com/youtubei/v1/search?prettyPrint=false",
      "headers": { "Content-Type": "application/json", "User-Agent": "Mozilla/5.0" },
      "bodyTemplate": "{\"query\":\"{query}\",\"context\":{\"client\":{\"clientName\":\"WEB_REMIX\",\"clientVersion\":\"1.20240101.01.00\",\"hl\":\"en\",\"gl\":\"US\"}},\"params\":\"EgWKAQIIAWoKEAkQBRAKEAMQBA%3D%3D\"}",
      "resultsKey": "flexColumns",
      "map": {
        "handle": "playlistItemData.videoId",
        "title": "flexColumns[0].musicResponsiveListItemFlexColumnRenderer.text.runs[0].text",
        "artist": "flexColumns[1].musicResponsiveListItemFlexColumnRenderer.text.runs[0].text?",
        "coverUrl": "thumbnail.musicThumbnailRenderer.thumbnail.thumbnails[0].url?"
      }
    }
  ],
  "resolve": [
    {
      "op": "http.get",
      "url": "https://www.youtube.com/iframe_api",
      "headers": { "User-Agent": "Mozilla/5.0" },
      "as": "iframe"
    },
    {
      "op": "regex.extract",
      "input": "{iframe}",
      "pattern": "player\\\\?/([a-z0-9]{8})\\\\?/",
      "group": 1,
      "as": "pid"
    },
    {
      "op": "url.template",
      "template": "https://www.youtube.com/s/player/{pid}/player_ias.vflset/en_US/base.js",
      "as": "playerUrl"
    },
    {
      "op": "http.get",
      "url": "{playerUrl}",
      "headers": { "User-Agent": "Mozilla/5.0" },
      "as": "base"
    },
    {
      "op": "regex.extract",
      "input": "{base}",
      "pattern": "signatureTimestamp:(\\d+)",
      "group": 1,
      "as": "sts"
    },
    {
      "op": "extract.solved",
      "url": "https://music.youtube.com/youtubei/v1/player?prettyPrint=false",
      "headers": { "Content-Type": "application/json", "User-Agent": "Mozilla/5.0" },
      "bodyTemplate": "{\"videoId\":\"{handle}\",\"context\":{\"client\":{\"clientName\":\"WEB_REMIX\",\"clientVersion\":\"1.20240101.01.00\",\"hl\":\"en\",\"gl\":\"US\"}},\"playbackContext\":{\"contentPlaybackContext\":{\"signatureTimestamp\":{sts}}}}",
      "statusPath": "playabilityStatus.status",
      "formatsPath": "streamingData.adaptiveFormats",
      "audioFilter": {
        "mimeType": { "startsWith": "audio/mp4; codecs=\"mp4a.40.2\"" }
      },
      "cipherField": "signatureCipher",
      "contentBinding": "{handle}",
      "playerUrl": "{playerUrl}"
    }
  ]
}
